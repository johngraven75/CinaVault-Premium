# ── Dependencies and build output ──
node_modules/
dist/
.vite/
src-tauri/target/
build/
*.pdb

# ── Bundled tools and models fetched at build time ──
src-tauri/tools/wireguard/wireguard.exe
src-tauri/tools/cloudflared/cloudflared.exe
public/models/
*.onnx.part

# ── Generated CI evidence and diagnostics ──
master-evidence/
release-diagnostics/
validation-logs/
test-evidence/
installer-staging/
test-results/
logs/
*.log
npm-debug.log*

# ── Installer and release archives (never commit a built installer) ──
*.msi
*.exe
*.zip
*.tar.gz
*.dmg
# Note: the two bundled-tool binaries fetched at build time are already
# covered above by their explicit paths; no .exe or .msi is tracked today.

# ── Local secrets and environment ──
.env
.env.*
!.env.store-safe
.envrc

# ── Local app data and scratch ──
src/**/*.cinavault.json
src/*.cinavault.json
.snapshots/
*.rej
*.spk

# ── Editors, OS and agent tooling ──
.DS_Store
Thumbs.db
.vscode/
.idea/
.cursorignore
.cursorindexingignore
.claude/
.clawness/

# ── Python helpers ──
__pycache__/
*.py[cod]
.venv/
venv/
