# Check text out with LF everywhere, including Windows runners (which set
# core.autocrlf=true): tests and scripts read sources and match on "\n".
* text=auto eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

releases/build-115/*.exe filter=lfs diff=lfs merge=lfs -text
releases/build-115/*.msi filter=lfs diff=lfs merge=lfs -text
releases/build-116/*.exe filter=lfs diff=lfs merge=lfs -text
releases/build-116/*.msi filter=lfs diff=lfs merge=lfs -text
releases/rc2-build1/*.exe filter=lfs diff=lfs merge=lfs -text
releases/rc2-build1/*.msi filter=lfs diff=lfs merge=lfs -text
